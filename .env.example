DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_server_id_here

# Optional — role ID that can see/manage tickets in addition to Manage Channels
STAFF_ROLE_ID=your_staff_role_id_here

# Optional — channel ID where closed-ticket transcripts get posted
LOG_CHANNEL_ID=your_log_channel_id_here

# Optional — hours of inactivity before a warning / auto-close (defaults shown)
AUTO_WARN_HOURS=12
AUTO_CLOSE_HOURS=24

# Optional — branding
BRAND_FOOTER=Ticket System
BRAND_THUMBNAIL=https://your-logo-url.png
